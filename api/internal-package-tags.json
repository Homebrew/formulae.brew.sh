---
---
{%- assign tags = "" | split: "" -%}
{%- assign package_paths = site.static_files | map: "path" | where_exp: "path", "path contains '/api/internal/packages.'" -%}
{%- for path in package_paths -%}
  {%- assign parts = path | split: "." -%}
  {%- if parts[0] == "/api/internal/packages" and parts.size == 3 and parts[2] == "json" -%}
    {%- assign tags = tags | push: parts[1] -%}
  {%- endif -%}
{%- endfor -%}
{{ tags | sort | jsonify }}
