---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  {% assign catalogue_path = page.package | prepend: '/' | append: '/' -%}
  {% assign feeds_key = page.package | append: '_feeds' -%}
  {% assign canonical_key = page.package | append: '_canonical' -%}
  <channel>
    <title>{{ page.title | xml_escape }}</title>
    <link>{{ catalogue_path | absolute_url | xml_escape }}</link>
    <description>{{ page.description | xml_escape }}</description>
    <language>en</language>
    <atom:link href="{{ page.url | absolute_url | xml_escape }}" rel="self" type="application/rss+xml" />
    {% assign entries = site.data[feeds_key][page.feed] -%}
    {% for entry in entries -%}
    {% assign name = site.data[canonical_key][entry.name] | default: entry.name -%}
    {% assign data_name = name | remove: '@' | remove: '.' | replace: '+', '_' -%}
    {% assign package = site.data[page.package][data_name] -%}
    {% capture commit_url %}{{ site.taps[page.tap].remote }}/commit/{{ entry.commit }}{% endcapture -%}
    <item>
      <title>{{ entry.name | xml_escape }}{% if entry.versions.size > 0 %} {{ entry.versions | join: ', ' | xml_escape }}{% endif %}</title>
      {% if package -%}
      <link>{{ name | prepend: catalogue_path | absolute_url | xml_escape }}</link>
      {% else -%}
      <link>{{ commit_url | xml_escape }}</link>
      {% endif -%}
      <guid isPermaLink="false">{{ entry.id | xml_escape }}</guid>
      <pubDate>{{ entry.date | date_to_rfc822 }}</pubDate>
      <description>{{ package.desc | default: entry.name | xml_escape }}</description>
      <category>{{ page.feed }}</category>
    </item>
    {% endfor -%}
  </channel>
</rss>
